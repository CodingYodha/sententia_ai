# ─────────────────────────────────────────────────────────────────────────────
# Sententia.ai — Environment Variables
# Copy this file to: backend/.env  AND  frontend/.env.local
# NEVER commit real keys. This file is safe to commit.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Providers ─────────────────────────────────────────────────────────────
# OpenRouter (primary LLM — Nemotron 3 Ultra, free tier)
# Sign up at https://openrouter.ai/ → Keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq Cloud (secondary LLM — Llama 3.3 70B, free tier)
# Sign up at https://console.groq.com/ → API Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Jina AI (primary embeddings, ~1M free tokens on signup)
# Sign up at https://jina.ai/embeddings/ → API Keys
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio (backup embeddings — text-embedding-004)
# Sign up at https://aistudio.google.com/ → Get API key
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vector Database (Qdrant) ───────────────────────────────────────────────────
# Sign up at https://cloud.qdrant.io/ → Create cluster → API Keys
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ───────────────────────────────────────────────────────────────────
# Sign up at https://supabase.com/ → New Project → Settings → API
# URL format: https://<project-ref>.supabase.co
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon key — safe for browser (used in frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# Service role key — server only, bypasses RLS (used in backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# JWT secret — Supabase → Project Settings → API → JWT Settings → JWT Secret
# Used by the backend to verify access tokens (HS256) — FR-7.1
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Supabase OAuth — Google (FR-7.1) ──────────────────────────────────────────
# Configure at Supabase → Authentication → Providers → Google
# Obtain credentials at https://console.cloud.google.com/
# (No env var needed here — configured in the Supabase dashboard)

# ── App Config ─────────────────────────────────────────────────────────────────
# Backend URL for frontend to call (change in prod to HF Spaces URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase public vars for frontend (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx
